# Required: copy this template to .env only if .env does not already exist.
# Keep keys local. Shell variables override .env values.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=financial-rag
PINECONE_API_MODE=documents
PINECONE_TEXT_FIELD=chunk_text
PINECONE_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_NAMESPACE_PREFIX=financial-rag-reference-v1
VECTOR_STORE=pinecone

# Standalone boundary embeddings; no OpenAI key required for this route.
SEMANTIC_EMBEDDING_PROVIDER=pinecone
SEMANTIC_EMBEDDING_MODEL=llama-text-embed-v2
CHUNK_DIR=data/chunks/reference

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=google/gemma-3-27b-it
RAGAS_JUDGE_PROVIDER=nebius

# Optional direct-embedding alternatives (not used in the reference pipeline above).
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

RAG_DEFAULT_STRATEGY=fixed

# SEC ingestion only: use your real contact identity; no SEC API key is needed.
SEC_USER_AGENT=

# Local diagnostics: JSON lines, 5 MB per file, three rotated backups.
LOG_LEVEL=INFO
LOG_DIR=logs
